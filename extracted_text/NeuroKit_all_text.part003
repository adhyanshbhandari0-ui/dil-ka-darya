    }
   ],
   "source": [
    "data, timing = resample_all(np.cos(np.linspace(start=0, stop=20, num=50)))\n",
    "data.iloc[:, :-1].plot(style=\".-\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "<matplotlib.axes._subplots.AxesSubplot at 0x1c73c1d6748>"
